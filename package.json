{
  "name": "mc-ai-bot",
  "version": "1.0.0",
  "description": "Mineflayer Minecraft bot with an Airi OS Windows desktop dashboard",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node --watch bot.js",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win nsis",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "minecraft-data": "^3.102.3",
    "minecraft-protocol": "^1.68.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "openai": "^6.15.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hexamania.mc-ai-bot",
    "productName": "Airi OS",
    "files": [
      "desktop/**/*",
      "bot.js",
      "memory.js",
      "memory.json",
      "index.html",
      "users.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
