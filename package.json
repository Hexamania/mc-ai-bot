{
  "name": "mc-ai-bot",
  "version": "2.0.0",
  "description": "Mineflayer Minecraft bot with Airi OS dashboard - modular architecture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build:main": "tsc -p desktop/tsconfig.json",
    "build:renderer": "vite build --config desktop/renderer/vite.config.ts",
    "build:desktop": "npm run build:main && npm run build:renderer",
    "dev:main": "tsx watch desktop/main.ts",
    "dev:renderer": "vite --config desktop/renderer/vite.config.ts",
    "dev:desktop": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "desktop": "electron dist/desktop/main.js",
    "desktop:dev": "npm run build:desktop && electron .",
    "desktop:dist": "electron-builder --win nsis",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p desktop/tsconfig.json && tsc --noEmit -p desktop/renderer/tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "husky install"
  },
  "keywords": [
    "mineflayer",
    "minecraft",
    "bot",
    "ai",
    "dashboard",
    "electron",
    "vue"
  ],
  "author": "Hexamania",
  "license": "ISC",
    "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^5.3.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.1.0",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "minecraft-data": "^3.102.3",
    "minecraft-protocol": "^1.68.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "node-notifier": "^10.0.1",
    "openai": "^4.52.0",
    "pinia": "^2.1.7",
    "signals": "^1.0.0",
    "socket.io": "^4.7.5",
    "vec3": "^0.1.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/node-notifier": "^8.0.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^8.2.0",
    "electron": "^28.2.3",
    "electron-builder": "^24.13.3",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yaml,yml,md,html,css,vue}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.hexamania.mc-ai-bot",
    "productName": "Airi OS",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "memory.json",
      "index.html",
      "users.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
