# Airi OS (mc-ai-bot) Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# Minecraft Bot Configuration
# =============================================================================

# Minecraft server address (hostname or IP)
MC_HOST=localhost

# Minecraft server port
MC_PORT=25565

# Bot username (in-game name)
MC_USERNAME=Airi

# Bot password (for online-mode servers, leave empty for offline-mode)
# MC_PASSWORD=your_password_here

# Minecraft client version (must be supported by Mineflayer)
# See https://github.com/PrismarineJS/mineflayer#supported-versions
MC_VERSION=1.21.1

# =============================================================================
# Web Dashboard Configuration
# =============================================================================

# Dashboard server port (default: 3000)
WEB_PORT=3000

# Dashboard server host (leave empty for localhost only, use 0.0.0.0 for all interfaces)
# WEB_HOST=0.0.0.0

# =============================================================================
# OpenAI Configuration (Optional - for AI chat features)
# =============================================================================

# OpenAI API key (get from https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-api-key-here

# Alternative variable name (also supported)
# OPENAI_KEY=sk-your-api-key-here

# OpenAI model to use (default: gpt-4)
# OPENAI_MODEL=gpt-4

# =============================================================================
# Memory Configuration
# =============================================================================

# Enable persistent memory (true/false)
# When enabled, bot saves locations, players, tasks, rules, and facts to memory.json
ENABLE_MEMORY=true

# Custom memory file path (default: ./memory.json)
# MEMORY_FILE=./memory.json

# =============================================================================
# Admin Configuration
# =============================================================================

# Admin command prefix (default: $)
# ADMIN_PREFIX=$

# Admin password for $loginadmin command
# ADMIN_PASSWORD=your_secure_admin_password

# Public command prefix (default: :)
# PREFIX=:

# =============================================================================
# Development/Production
# =============================================================================

# Node environment (development/production)
# NODE_ENV=development

# =============================================================================
# Desktop App Specific (Electron)
# =============================================================================

# Set to 1 to disable system tray minimization (for debugging)
# AIRIOS_NO_TRAY=0

# Portable mode marker (set automatically by installer)
# AIRIOS_PORTABLE=0

# App version (set automatically at build time)
# APP_VERSION=2.0.0