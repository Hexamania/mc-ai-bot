{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "dom"],
    "outDir": "./dist/desktop",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@desktop/*": ["./*"]
    },
    "types": ["node", "electron"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "renderer", "bot-worker"],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
