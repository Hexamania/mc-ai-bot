# Airi OS EditorConfig
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab

[*.{html,vue,xml,svg}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.py]
indent_size = 4